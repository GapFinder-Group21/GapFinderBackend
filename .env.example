# Copy this file to .env and put the real values. .env is NOT committed.
# With only these dummy values the backend starts, but the Google Calendar import does not work.
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-client-secret
# Where Google sends the browser after the login. Local: http://localhost:8080/google/callback
# Production: https://<your-domain>/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/google/callback
# Long random key used to sign the login tokens (generate one with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters
# Production only: public domain served by Caddy
DOMAIN=gapfinder.example.duckdns.org
